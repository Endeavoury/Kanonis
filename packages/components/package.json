{
  "name": "@endeavoury/kanonis",
  "version": "1.0.24",
  "description": "Framework-independent Kanonis Web Components built with Lit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endeavoury/Kanonis.git",
    "directory": "packages/components"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/entry.js",
    "./dist/components/*/register.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./classes": {
      "types": "./dist/classes.d.ts",
      "import": "./dist/classes.js"
    },
    "./button": {
      "types": "./dist/components/button/entry.d.ts",
      "import": "./dist/components/button/entry.js"
    },
    "./forms": {
      "types": "./dist/components/forms/entry.d.ts",
      "import": "./dist/components/forms/entry.js"
    },
    "./secondary-forms": {
      "types": "./dist/components/secondary-forms/entry.d.ts",
      "import": "./dist/components/secondary-forms/entry.js"
    },
    "./display": {
      "types": "./dist/components/display/entry.d.ts",
      "import": "./dist/components/display/entry.js"
    },
    "./feedback": {
      "types": "./dist/components/feedback/entry.d.ts",
      "import": "./dist/components/feedback/entry.js"
    },
    "./interaction": {
      "types": "./dist/components/interaction/entry.d.ts",
      "import": "./dist/components/interaction/entry.js"
    },
    "./overlays": {
      "types": "./dist/components/overlays/entry.d.ts",
      "import": "./dist/components/overlays/entry.js"
    },
    "./upload": {
      "types": "./dist/components/upload/entry.d.ts",
      "import": "./dist/components/upload/entry.js"
    },
    "./data-table": {
      "types": "./dist/components/data-table/entry.d.ts",
      "import": "./dist/components/data-table/entry.js"
    },
    "./layout": {
      "types": "./dist/components/layout/entry.d.ts",
      "import": "./dist/components/layout/entry.js"
    },
    "./navigation": {
      "types": "./dist/components/navigation/entry.d.ts",
      "import": "./dist/components/navigation/entry.js"
    },
    "./navigation-extras": {
      "types": "./dist/components/navigation-extras/entry.d.ts",
      "import": "./dist/components/navigation-extras/entry.js"
    },
    "./patterns": {
      "types": "./dist/components/patterns/entry.d.ts",
      "import": "./dist/components/patterns/entry.js"
    },
    "./tree": {
      "types": "./dist/components/tree/entry.d.ts",
      "import": "./dist/components/tree/entry.js"
    },
    "./enterprise": {
      "types": "./dist/components/enterprise/entry.d.ts",
      "import": "./dist/components/enterprise/entry.js"
    },
    "./enterprise-p1": {
      "types": "./dist/components/enterprise-p1/entry.d.ts",
      "import": "./dist/components/enterprise-p1/entry.js"
    },
    "./enterprise-p2": {
      "types": "./dist/components/enterprise-p2/entry.d.ts",
      "import": "./dist/components/enterprise-p2/entry.js"
    },
    "./enterprise-p3": {
      "types": "./dist/components/enterprise-p3/entry.d.ts",
      "import": "./dist/components/enterprise-p3/entry.js"
    },
    "./enhancements": {
      "types": "./dist/components/enhancements/entry.d.ts",
      "import": "./dist/components/enhancements/entry.js"
    }
  },
  "scripts": {
    "build": "tsc -b && cp ../styles/src/global.css dist/styles.css"
  },
  "dependencies": {
    "@endeavoury/kanonis-styles": "1.0.24",
    "@endeavoury/kanonis-tokens": "1.0.24",
    "lit": "3.3.3",
    "tslib": "2.8.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
